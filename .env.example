# App
APP_NAME=Heartline
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://localhost:5432/heartline

# Redis
REDIS_URL=redis://localhost:6379/0

# Gemini AI (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# JWT (최소 32자 이상의 랜덤 문자열 사용)
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Kakao OAuth (https://developers.kakao.com)
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao/callback

# CORS
CORS_ORIGINS=["http://localhost:5173"]
